<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wled_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/wled_widget_background">
    <LinearLayout android:id="@+id/wled_widget_open" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/wled_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Room lighting" android:textColor="#F0F1E9" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/wled_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WLED" android:textColor="#A8B1A5" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <Button android:id="@+id/wled_widget_action" android:layout_width="match_parent" android:layout_height="48dp" android:text="Switch lights" android:textAllCaps="false" android:backgroundTint="#B5F36A" android:textColor="#101310" />
</LinearLayout>
